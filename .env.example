# ==============================================================================
# AMR Drug Target Discovery - Environment Configuration Template
# Place actual secrets only in local .env (never commit .env to version control)
# ==============================================================================

# Application & Server Configuration
PORT=8501
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=false

# Database & Persistent Storage
# For local SQLite: leave DATABASE_URL blank or comment out
# For PostgreSQL (Render / Production):
DATABASE_URL=postgresql://amr_admin:password_placeholder@localhost:5432/amr_discovery
SQLITE_DB_PATH=data/amr_discovery.db

# External Scientific APIs
CHEMBL_BASE_URL=https://www.ebi.ac.uk/chembl/api/data
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
UNIPROT_BASE_URL=https://rest.uniprot.org/uniprotkb
RCSB_PDB_BASE_URL=https://files.rcsb.org/download

# Experiment Tracking & Caching
MLFLOW_TRACKING_URI=file:./mlruns
MODEL_CACHE_DIR=artifacts/checkpoints
EMBEDDINGS_CACHE_DIR=artifacts/embeddings

# Docking & Computational Tools
VINA_BINARY_PATH=vina
